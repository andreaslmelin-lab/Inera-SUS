{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
        "isBlocked": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "inviteCode": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Invitation code for user registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
        "status": { "type": "string", "enum": ["active", "used", "revoked"] },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["code", "email", "role", "status"]
    },
    "Train": {
      "title": "Train",
      "description": "An organizational train",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Team": {
      "title": "Team",
      "description": "An organizational team",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "trainId": { "type": "string" }
      },
      "required": ["id", "name", "trainId"]
    },
    "Product": {
      "title": "Product",
      "description": "A main product in Inera's catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teamId": { "type": "string" }
      },
      "required": ["id", "name", "teamId"]
    },
    "SusSurvey": {
      "title": "SusSurvey",
      "description": "A SUS survey round",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "type": { "type": "string", "enum": ["general", "unique"] },
        "endDate": { "type": "string", "format": "date-time" },
        "maxResponses": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "name", "status"]
    },
    "Variant": {
      "title": "Variant",
      "description": "A variant or function of a main product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "productId", "name"]
    },
    "Measurement": {
      "title": "Measurement",
      "description": "A batch of SUS responses uploaded at a specific time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" },
        "fileName": { "type": "string" },
        "averageScore": { "type": "number" },
        "responseCount": { "type": "number" }
      },
      "required": ["id", "productId", "date"]
    },
    "Response": {
      "title": "Response",
      "description": "An individual SUS response",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "measurementId": { "type": "string" },
        "productId": { "type": "string" },
        "variantName": { "type": "string" },
        "susScore": { "type": "number" },
        "answers": { "type": "array", "items": { "type": "number" } },
        "comment": { "type": "string" },
        "submitDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "measurementId", "productId", "susScore"]
    },
    "RawDataExport": {
      "title": "RawDataExport",
      "description": "Raw data export from external apps",
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "timestamp": { "type": "string" },
        "organization": { "type": "string" },
        "metrics": { "type": "object" },
        "granularData": { "type": "object" }
      },
      "required": ["source", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/invitations/{invitationId}": {
      "schema": { "$ref": "Invitation" },
      "description": "User invitations"
    },
    "/trains/{trainId}": {
      "schema": { "$ref": "Train" },
      "description": "Organizational trains"
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "Team" },
      "description": "Organizational teams"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Main products"
    },
    "/susSurveys/{surveyId}": {
      "schema": { "$ref": "SusSurvey" },
      "description": "SUS survey rounds"
    },
    "/products/{productId}/variants/{variantId}": {
      "schema": { "$ref": "Variant" },
      "description": "Product variants"
    },
    "/measurements/{measurementId}": {
      "schema": { "$ref": "Measurement" },
      "description": "Measurement batches"
    },
    "/responses/{responseId}": {
      "schema": { "$ref": "Response" },
      "description": "Individual responses"
    },
    "/raw_data_exports/{exportId}": {
      "schema": { "$ref": "RawDataExport" },
      "description": "Raw data exports"
    }
  }
}
